#!/usr/bin/env bash
# Refuse a commit that contains a secret. Enabled per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the commit is refused. Install it with: brew install gitleaks" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
gitleaks git --pre-commit --staged --redact --no-banner --config "$root/.gitleaks.toml" "$root"
